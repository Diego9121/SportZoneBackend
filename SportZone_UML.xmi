      <packagedElement xmi:type="uml:Actor" xmi:id="actor_Cloudinary" name="Cloudinary"/>

      <!-- Casos de uso del Administrador -->
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_a1" name="Iniciar Sesion"/>
      <packagedElement xmi:type="uml:UseCase" xmi:id="uc_a2" name="Gestionar Roles y Usuarios"/>
