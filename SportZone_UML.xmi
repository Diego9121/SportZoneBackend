    <!-- ============================================================ -->
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_casosuso" name="Diagrama de Casos de Uso">

      <packagedElement xmi:type="uml:Actor" xmi:id="actor_Administrador" name="Administrador"/>
